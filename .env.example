# Context Blocks — Environment Variables
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# LLM_API_KEY is required. OPENAI_API_KEY is needed for embeddings
# (retrieval, evals, ask). Everything else has sensible defaults.

# ── LLM Provider ──
# Supported: anthropic, openai, gemini
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6
LLM_API_KEY=

# ── Embeddings ──
# Used by retrieval (ask, eval, serve). Falls back to local fastembed if unset.
OPENAI_API_KEY=

# ── Alternative Providers ──
# For Gemini: pip install 'context-blocks[gemini]'
# GOOGLE_API_KEY=

# ── LLM Parameters ──
# LLM_TEMPERATURE=0.0
# LLM_MAX_TOKENS=64000
# LLM_REQUEST_TIMEOUT=600.0
# LLM_CONNECT_TIMEOUT=10.0

# ── Token Management ──
# CONTEXT_WINDOW_DEFAULT=100000
# RESPONSE_TOKEN_RESERVE=8000
# SYNTHESIS_MAX_TOKENS=4000

# ── Pipeline ──
# MIN_DOC_TOKENS=20
# MAX_CONSECUTIVE_FAILURES=3

# ── Retrieval ──
# RETRIEVAL_TOKEN_BUDGET=8000
# RETRIEVAL_MAX_RESULTS=15
# RETRIEVAL_VECTOR_TOP_K=200
# RETRIEVAL_GRAPH_MAX_HOPS=3
# GAP_CONFIDENCE_THRESHOLD=0.4

# ── API Server ──
# API_PORT=8321

# ── Workspace ──
# Which set of blocks the CLI and Studio operate on.
#   public  -> synthetic example domains
#   private -> your private blocks
# Unset = legacy walk-up discovery (blocks.yaml at the repo root).
# CB_PROJECT_ROOT (an explicit path) overrides the workspace selection.
CB_WORKSPACE=private
CB_WORKSPACE_PUBLIC=synthetic-domains
CB_WORKSPACE_PRIVATE=.private/blocks

# ── Paths ──
# OUTPUT_DIR=output

# ── Logging ──
# LOG_LEVEL=INFO
