# Context Blocks Viewer — Environment Variables
#
# Copy this file to .env and adjust values for your setup.
# All variables are optional — sensible defaults are used when unset.

# ── Data Source ──
# Path to your extraction output directory (contains entities/, analysis-report.md, etc.)
# If unset, the viewer auto-discovers: ./output → ../output → first synthetic-domains/*/output
# CB_OUTPUT_DIR=../output

# ── API Server ──
# Base URL of the Context Blocks API server (for live Ask queries).
# Only needed if you want live Q&A — pre-computed eval results work without it.
# PUBLIC_CB_API_BASE=http://localhost:8321

# ── Dev Server ──
# Port for the Astro dev server (default: 4321)
# ASTRO_PORT=4321
